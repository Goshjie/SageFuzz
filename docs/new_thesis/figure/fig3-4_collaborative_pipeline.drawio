        <mxCell id="ddv" style="strokeColor=#E53935;strokeWidth=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="d" target="vd" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Dashed feedback arrows -->
        <mxCell id="fba" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#EF5350;dashed=1;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=0;entryY=1;" edge="1" source="va" target="a" parent="1">
