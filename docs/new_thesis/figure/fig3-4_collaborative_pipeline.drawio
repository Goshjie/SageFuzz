          <mxGeometry x="468" y="170" width="60" height="14" as="geometry"/>
        </mxCell>

        <!-- Stage D -->
        <mxCell id="d" value="执行序列&#xa;组装" style="rounded=1;fillColor=#E1BEE7;strokeColor=#8E24AA;fontSize=11;fontStyle=1;fontColor=#4A148C;" vertex="1" parent="1">
          <mxGeometry x="630" y="30" width="150" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="vd" value="确定性校验" style="rounded=1;fillColor=#FFCDD2;strokeColor=#EF5350;fontSize=9;fontStyle=1;fontColor=#B71C1C;dashed=1;dashPattern=6 3;" vertex="1" parent="1">
          <mxGeometry x="640" y="142" width="130" height="26" as="geometry"/>
