        </mxCell>

        <!-- Horizontal flow arrows -->
        <mxCell id="eab" value="PacketSequence" style="strokeColor=#1E88E5;strokeWidth=2;fontSize=8;fontStyle=1;fontColor=#1565C0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="a" target="b" parent="1">
