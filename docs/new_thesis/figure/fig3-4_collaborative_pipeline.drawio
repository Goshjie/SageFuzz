<mxfile>
  <diagram name="多阶段协同生成流水线" id="fig3-4">
    <mxGraphModel dx="860" dy="320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="320" math="0" shadow="0">
      <root>
