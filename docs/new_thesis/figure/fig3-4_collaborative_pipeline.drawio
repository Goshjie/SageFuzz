          <mxGeometry x="268" y="170" width="60" height="14" as="geometry"/>
        </mxCell>

        <!-- Stage C -->
        <mxCell id="c" value="预言机&#xa;预测" style="rounded=1;fillColor=#FFE0B2;strokeColor=#FB8C00;fontSize=11;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="430" y="30" width="140" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="vc" value="确定性校验" style="rounded=1;fillColor=#FFCDD2;strokeColor=#EF5350;fontSize=9;fontStyle=1;fontColor=#B71C1C;dashed=1;dashPattern=6 3;" vertex="1" parent="1">
