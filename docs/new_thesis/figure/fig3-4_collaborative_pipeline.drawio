        <mxCell id="va" value="确定性校验" style="rounded=1;fillColor=#FFCDD2;strokeColor=#EF5350;fontSize=9;fontStyle=1;fontColor=#B71C1C;dashed=1;dashPattern=6 3;" vertex="1" parent="1">
