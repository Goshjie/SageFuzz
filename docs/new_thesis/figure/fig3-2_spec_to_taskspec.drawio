<mxfile>
  <diagram name="P4LTL 规范到 TaskSpec 的结构化分解" id="fig3-2">
    <mxGraphModel dx="780" dy="400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- LEFT: P4LTL Spec -->
        <mxCell id="spec_bg" value="" style="rounded=1;fillColor=#E8F5E9;strokeColor=#66BB6A;strokeWidth=1;opacity=40;" vertex="1" parent="1">
          <mxGeometry x="15" y="20" width="175" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="spec" value="P4LTL 规范&#xa;──────────&#xa;#LTLProperty&#xa;#LTLFairness&#xa;#LTLVariables&#xa;#CPI_SPEC" style="rounded=1;fillColor=#C8E6C9;strokeColor=#43A047;fontSize=10;fontColor=#1B5E20;align=left;spacingLeft=12;spacingTop=4;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="25" y="45" width="155" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="spec_lbl" value="输入" style="text;fontSize=9;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#2E7D32;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="24" width="40" height="16" as="geometry"/>
        </mxCell>

        <!-- MIDDLE: Three decomposition dimensions -->
        <mxCell id="mid_bg" value="" style="rounded=1;fillColor=#E3F2FD;strokeColor=#42A5F5;strokeWidth=1;opacity=40;" vertex="1" parent="1">
          <mxGeometry x="245" y="20" width="225" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="mid_lbl" value="三维分解" style="text;fontSize=9;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#1565C0;align=center;" vertex="1" parent="1">
          <mxGeometry x="325" y="24" width="60" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="dim1" value="时序逻辑分离" style="rounded=1;fillColor=#BBDEFB;strokeColor=#1E88E5;fontSize=11;fontStyle=1;fontColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="270" y="50" width="175" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="dim2" value="控制面约束提取" style="rounded=1;fillColor=#BBDEFB;strokeColor=#1E88E5;fontSize=11;fontStyle=1;fontColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="270" y="118" width="175" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="dim3" value="数据面特征映射" style="rounded=1;fillColor=#BBDEFB;strokeColor=#1E88E5;fontSize=11;fontStyle=1;fontColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="270" y="186" width="175" height="42" as="geometry"/>
        </mxCell>

        <!-- RIGHT: TaskSpec -->
        <mxCell id="ts_bg" value="" style="rounded=1;fillColor=#FFF3E0;strokeColor=#FFA726;strokeWidth=1;opacity=40;" vertex="1" parent="1">
          <mxGeometry x="540" y="20" width="210" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="ts_lbl" value="输出" style="text;fontSize=9;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#E65100;align=center;" vertex="1" parent="1">
          <mxGeometry x="620" y="24" width="40" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="ts" value="TaskSpec 六元组&#xa;──────────&#xa;κ : 意图分类&#xa;R : 角色绑定&#xa;Λ : 场景契约&#xa;E : 环境约束&#xa;A : 外部动作&#xa;O : 观测需求" style="rounded=1;fillColor=#FFE0B2;strokeColor=#FB8C00;fontSize=10;fontColor=#E65100;align=left;spacingLeft=12;spacingTop=4;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="555" y="42" width="175" height="180" as="geometry"/>
        </mxCell>

        <!-- BOTTOM: ProgramContext query -->
        <mxCell id="pctx" value="ProgramContext 工具查询" style="rounded=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontStyle=1;fontColor=#F57F17;dashed=1;dashPattern=8 4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="285" y="300" width="190" height="32" as="geometry"/>
        </mxCell>

        <!-- Arrows: spec → dimensions -->
        <mxCell id="a_s1" style="strokeColor=#43A047;strokeWidth=1.5;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" source="spec" target="dim1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_s2" style="strokeColor=#43A047;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="spec" target="dim2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_s3" style="strokeColor=#43A047;strokeWidth=1.5;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" source="spec" target="dim3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Arrows: dimensions → TaskSpec -->
        <mxCell id="a_d1" style="strokeColor=#1E88E5;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.15;" edge="1" source="dim1" target="ts" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_d2" style="strokeColor=#1E88E5;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="dim2" target="ts" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_d3" style="strokeColor=#1E88E5;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.85;" edge="1" source="dim3" target="ts" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Dashed arrows: PCtx → dim2, dim3 -->
        <mxCell id="tq1" style="strokeColor=#F9A825;dashed=1;dashPattern=6 4;strokeWidth=1.5;exitX=0.3;exitY=0;entryX=0.5;entryY=1;" edge="1" source="pctx" target="dim2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="tq2" style="strokeColor=#F9A825;dashed=1;dashPattern=6 4;strokeWidth=1.5;exitX=0.7;exitY=0;entryX=0.5;entryY=1;" edge="1" source="pctx" target="dim3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
